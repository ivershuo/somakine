{
  "name": "@somakine/core",
  "version": "0.2.0-alpha.0",
  "description": "Schema, validation, and catalog for Somakine data packs.",
  "repository": { "type": "git", "url": "git+https://github.com/ivershuo/somakine.git", "directory": "packages/core" },
  "homepage": "https://github.com/ivershuo/somakine#readme",
  "bugs": { "url": "https://github.com/ivershuo/somakine/issues" },
  "author": "Somakine contributors",
  "keywords": ["anatomy", "musculoskeletal", "data-pack", "validation", "typescript", "somakine"],
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/**/*.js", "dist/**/*.js.map", "dist/**/*.d.ts", "dist/**/*.d.ts.map", "README.md"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=20"
  }
}
