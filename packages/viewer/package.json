{
  "name": "@somakine/viewer",
  "version": "0.1.0-alpha.1",
  "description": "Framework-neutral Three.js viewer for Somakine.",
  "repository": { "type": "git", "url": "git+https://github.com/ivershuo/somakine.git", "directory": "packages/viewer" },
  "homepage": "https://github.com/ivershuo/somakine#readme",
  "bugs": { "url": "https://github.com/ivershuo/somakine/issues" },
  "author": "Somakine contributors",
  "keywords": ["anatomy", "3d", "three.js", "viewer", "musculoskeletal", "typescript", "somakine"],
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/**/*.js", "dist/**/*.js.map", "dist/**/*.d.ts", "dist/**/*.d.ts.map", "README.md"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@somakine/core": "0.1.0-alpha.0"
  },
  "peerDependencies": {
    "three": ">=0.180.0 <1"
  }
