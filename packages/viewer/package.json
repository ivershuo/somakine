{
  "name": "@somakine/viewer",
  "version": "0.1.0-alpha.0",
  "description": "Framework-neutral Three.js viewer for Somakine.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/**/*.js", "dist/**/*.js.map", "dist/**/*.d.ts", "dist/**/*.d.ts.map", "README.md"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@somakine/core": "0.1.0-alpha.0"
  },
  "peerDependencies": {
    "three": ">=0.180.0 <1"
  }
}
