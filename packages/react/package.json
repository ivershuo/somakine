{
  "name": "@somakine/react",
  "version": "0.1.0-alpha.0",
  "description": "React component for the Somakine 3D anatomy viewer.",
  "repository": { "type": "git", "url": "git+https://github.com/ivershuo/somakine.git", "directory": "packages/react" },
  "homepage": "https://github.com/ivershuo/somakine#readme",
  "bugs": { "url": "https://github.com/ivershuo/somakine/issues" },
  "author": "Somakine contributors",
  "keywords": ["anatomy", "3d", "three.js", "viewer", "react", "somakine", "musculoskeletal", "typescript"],
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/**/*.js", "dist/**/*.js.map", "dist/**/*.d.ts", "dist/**/*.d.ts.map", "README.md"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@somakine/core": "0.1.0-alpha.0",
    "@somakine/viewer": "0.1.0-alpha.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "three": ">=0.180.0 <1"
  }
}
