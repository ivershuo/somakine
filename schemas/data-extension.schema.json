{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somakine.dev/schemas/data-extension-0.1.0.json",
  "title": "Somakine data extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "title", "description", "createdAt",
    "namespace", "targetPack", "sources", "licenses", "regions", "structures",
    "relations", "assets", "meshInstances", "representations", "locales", "mappings"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "namespace": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "targetPack": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "data-pack-0.1.0.json#/$defs/source" } },
    "licenses": { "type": "array", "minItems": 1, "items": { "$ref": "data-pack-0.1.0.json#/$defs/license" } },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "structures": { "type": "array", "items": { "$ref": "#/$defs/structure" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "assets": { "type": "array", "items": { "oneOf": [{ "$ref": "data-pack-0.1.0.json#/$defs/primitiveAsset" }, { "$ref": "data-pack-0.1.0.json#/$defs/gltfAsset" }] } },
    "meshInstances": { "type": "array", "items": { "$ref": "data-pack-0.1.0.json#/$defs/meshInstance" } },
    "representations": { "type": "array", "items": { "$ref": "#/$defs/representation" } },
    "locales": { "type": "array", "items": { "$ref": "#/$defs/locale" } },
    "mappings": { "type": "array", "items": { "$ref": "#/$defs/mapping" } }
  },
  "$defs": {
    "region": {
      "type": "object", "additionalProperties": false, "required": ["id", "order", "sourceIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^somakine:region:[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "order": { "type": "integer", "minimum": 0 },
        "sourceIds": { "$ref": "data-pack-0.1.0.json#/$defs/sourceIds" }
      }
    },
    "structure": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "laterality", "regionIds", "externalIds", "sourceIds", "reviewState"],
      "properties": {
        "id": { "type": "string", "pattern": "^somakine:structure:[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": { "enum": ["bone", "joint", "ligament", "muscle", "tendon", "skin"] },
        "laterality": { "enum": ["none", "paired", "midline", "variable"] },
        "regionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^somakine:region:" } },
        "externalIds": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "sourceIds": { "$ref": "data-pack-0.1.0.json#/$defs/sourceIds" },
        "reviewState": { "$ref": "data-pack-0.1.0.json#/$defs/reviewState" }
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "sourceId", "targetId", "sourceIds", "reviewState"],
      "properties": {
        "id": { "type": "string", "pattern": "^somakine:relation:[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": { "enum": ["part_of", "articulates_with", "attaches_to", "originates_from", "inserts_into", "crosses", "contains"] },
        "sourceId": { "type": "string", "pattern": "^somakine:structure:" },
        "targetId": { "type": "string", "pattern": "^somakine:structure:" },
        "sourceIds": { "$ref": "data-pack-0.1.0.json#/$defs/sourceIds" },
        "reviewState": { "$ref": "data-pack-0.1.0.json#/$defs/reviewState" }
      }
    },
    "representation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "structureId", "mode", "instanceIds", "contextStructureIds", "sourceIds", "reviewState"],
      "properties": {
        "id": { "type": "string", "pattern": "^somakine:representation:[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "structureId": { "type": "string", "pattern": "^somakine:structure:" },
        "mode": { "enum": ["direct", "compound", "context", "unavailable"] },
        "instanceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^somakine:instance:" } },
        "contextStructureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^somakine:structure:" } },
        "sourceIds": { "$ref": "data-pack-0.1.0.json#/$defs/sourceIds" },
        "reviewState": { "$ref": "data-pack-0.1.0.json#/$defs/reviewState" }
      }
    },
    "locale": {
      "type": "object", "additionalProperties": false, "required": ["locale", "labels", "aliases"],
      "properties": {
        "locale": { "type": "string", "minLength": 2 },
        "labels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "aliases": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
      }
    },
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["targetStructureId", "match", "confidence", "sourceIds", "reviewState"],
      "properties": {
        "targetStructureId": { "type": "string", "pattern": "^somakine:structure:" },
        "match": { "enum": ["exact", "synonym", "expert-reviewed"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceIds": { "$ref": "data-pack-0.1.0.json#/$defs/sourceIds" },
        "reviewState": { "$ref": "data-pack-0.1.0.json#/$defs/reviewState" }
      }
    }
  }
}
